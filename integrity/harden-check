#!/usr/bin/python3 -IB
"""harden-check - root drift check (review 2026-11-17, D-U1; scope 2026-11-22).

Installed root-owned in /usr/local/sbin by harden-workstation.sh integrity. Never fixes.

  harden-check            the checks below -> RESULT (aidecheck.service, after aide --check)
  harden-check --init     first AIDE database (the section, when there is none)
  harden-check --accept   admin, text console: aide --update, then counts per group on
                          the screen, the "other" (not explained) changes numbered page by
                          page, and the full numbered list in a file the daily user can
                          read (/tmp/from-admin, names only); typing the code at the top
                          of that list takes exactly that database as the new baseline
                          (only the admin accepts: the daily user can never take a change
                          in by itself)
  harden-check --list     every change of the last aide report, one per line: group, kind,
                          path (admin scripts explain the "other" ones before an accept)

Checks: aide (files changed since the last accept, grouped: from an OS update / GDM greeter
/ other),
boot-image (kernel + initramfs in /boot = the copy in the image: the initramfs is not
covered by Secure Boot), sudoers, auditd-conf, audit-loaded, accounts, firewalld-conf,
bpf-jit, applied. RESULT is read by sectop (posture row harden-check): root-owned,
group sectop, one line per check, then its items. No names of accounts in it.
"""

import datetime
import filecmp
import glob
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
import time

os.environ["PATH"] = "/usr/bin:/usr/sbin"
os.environ["LC_ALL"] = "C"

STATE = "/var/lib/harden-check"
RESULT = STATE + "/result"
ACCEPTED = STATE + "/accepted"
AIDE = "/usr/sbin/aide"
AIDE_CONF = "/etc/aide.conf"
AIDE_DB = "/var/lib/aide/aide.db.gz"
AIDE_NEW = "/var/lib/aide/aide.db.new.gz"
AIDE_JSON = "/var/log/aide/aide.json"
APPLIED = "/etc/harden-workstation/applied"
SUDOERS = "/etc/sudoers"
SUDOERS_D = "/etc/sudoers.d"
AUDITD_CONF = "/etc/audit/auditd.conf"
RULES_D = "/etc/audit/rules.d"
SHADOW = "/etc/shadow"
PASSWD_DB = "/etc/passwd"
FIREWALLD_CONF = "/etc/firewalld/firewalld.conf"
BPF_JIT = "/proc/sys/net/core/bpf_jit_harden"
CMDLINE = "/proc/cmdline"
BOOT = "/boot"
OSTREE_REPO = "/ostree/repo"
GROUP = "sectop"                 # reads RESULT (posture)
FRESH = 2 * 3600                 # aide.json older than this: aide did not report this run
MAX_ITEMS = 200                  # item lines per check in RESULT
# same values as sec_auditd in harden-workstation.sh (tests/test_integrity.py compares)
AUDITD_WANT = {"disk_error_action": "SYSLOG", "space_left_action": "SYSLOG",
               "admin_space_left_action": "SUSPEND", "disk_full_action": "SUSPEND",
               "max_log_file_action": "ROTATE", "max_log_file": "32", "num_logs": "40"}
DEFAULT_ZONE = "drop"
BPF_JIT_WANT = "2"
# written again by every new deployment (inputs from the image): an update explains them
# audit.rules (+ .prev): augenrules at the boot into a new deployment, after
# audit-privileged-sync rewrote 55-privileged.rules (audit-loaded checks the loaded rules)
GENERATED = ("/etc/ld.so.cache", "/etc/udev/hwdb.bin", "/etc/.updated",
             "/etc/selinux/targeted/", "/etc/audit/audit.rules", "/etc/audit/audit.rules.prev")
UPDATE_TREES = ("/boot/ostree/", "/boot/loader")
# old commit pruned (no ostree diff): an /etc file the same as the image's default
# (/usr/etc of the booted deployment: content, type, mode, owner) came with the update;
# not when aide saw its label / ACL / xattrs change (host 2026-11-27, admin 78)
ETC = "/etc"
USR_ETC = "/usr/etc"
LABEL_ATTRS = {"selinux", "acl", "xattrs"}
# setuid / setgid rules: audit-privileged-sync at the boot into a new deployment
PRIV_RULES = "/etc/audit/rules.d/55-privileged.rules"
PRIV_SYNC = "/usr/local/sbin/audit-privileged-sync"
PRIV_OWNER = 0                   # owner of 55-privileged.rules (tests: their own uid)
AUDIT_TOOLS = ("/usr/sbin/auditctl", "/usr/sbin/auditd", "/usr/sbin/ausearch",
               "/usr/sbin/aureport", "/usr/sbin/audispd", "/usr/sbin/augenrules")
SAFE = re.compile(r"[^\x20-\x7e]")
# GDM 50 runs the login screen as a dynamic user gdm-greeter[-N] (uid range of systemd's
# greeter users, systemd.io/UIDS-GIDS: 60578-60705); logind writes resource drop-ins for
# every new uid (host 2026-11-24: one property line per file, same values each time).
# Grouped "greeter" only when each file is that one line, the folders hold nothing else,
# all root-owned, and the journal holds GDM's PAM line for the uid, written by root.
GREETER_UIDS = range(60578, 60706)
GREETER_OWNER = 0                # owner of the drop-ins (tests: their own uid)
GREETER_RE = re.compile(r"/etc/systemd/system\.control/user(?:-(\d+)\.slice|@(\d+)\.service)\.d"
                        r"(?:/50-(CPUWeight|IOWeight|MemoryLow|MemoryMin)\.conf)?")
GREETER_FILE_RE = re.compile(r"50-(CPUWeight|IOWeight|MemoryLow|MemoryMin)\.conf")
GREETER_VALUE_RE = re.compile(r"\d{1,6}")
GREETER_PAM = re.compile(r"pam_unix\(gdm-launch-environment:session\): session opened for "
                         r"user gdm-greeter(?:-\d+)?\(uid=(\d+)\)")
GREETER_JOURNAL = ["journalctl", "-q", "--no-pager", "-o", "json", "--since=-30d",
                   "--output-fields=MESSAGE,_UID", "-g", "session opened for user gdm-greeter"]
# --init / --accept run aide the way aidecheck.service does (same SELinux domain change,
# capabilities, umask, no network): a file one run can read and the other cannot would
# show as a change (tests/test_integrity.py: same as integrity/aidecheck.service)
UNIT_PROPS = ("IPAddressDeny=any", "UMask=0077",
              "CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_FOWNER "
              "CAP_CHOWN CAP_AUDIT_CONTROL CAP_SYS_ADMIN")
# --accept (decision 2026-11-25: a long list cannot be scrolled on the text console)
OUTBOX = "/tmp/from-admin"       # one way, admin -> daily user (as tools/admin-run.sh)
ACCEPTS = STATE + "/accepts"     # the lists taken in, root only, newest KEEP_ACCEPTS kept
KEEP_ACCEPTS = 20
CODE_LEN = 8                     # first characters of the list's sha256 (as admin-run.sh)
CODE_TRIES = 3
TICK = 15                        # seconds between "still running" lines of aide --update
AIDECHECK = "aidecheck.service"
GROUPS = (("other", "not explained, read each one"),
          ("greeter", "GDM login screen drop-ins"),
          ("update", "from the OS update since the last accept"))
ATTR = re.compile(r"[a-z0-9_]{1,20}")


def clean(s: str) -> str:
    """One printable ASCII line (paths, command output)."""
    return SAFE.sub("?", str(s).replace("\t", " "))[:300]


class Check:
    def __init__(self, cid: str):
        self.id, self.status, self.summary, self.items = cid, "unknown", "", []

    def set(self, status: str, summary: str):
        self.status, self.summary = status, summary
        return self

    def item(self, text: str):
        self.items.append(clean(text))


def run(argv: list, timeout: int = 120) -> subprocess.CompletedProcess:
    return subprocess.run(argv, capture_output=True, text=True, timeout=timeout,
                          errors="replace", stdin=subprocess.DEVNULL)


def read(path: str) -> str:
    with open(path, encoding="utf-8", errors="replace") as f:
        return f.read()


# --- deployments ------------------------------------------------------------------------

def booted_deployment(cmdline: str = None) -> tuple:
    """(commit checksum of the booted deployment, boot checksum) from ostree= on the
    kernel command line: /ostree/boot.N/<os>/<bootcsum>/<serial> -> the deployment
    folder <commit>.<serial>. ("", "") if not an ostree boot."""
    cmdline = read(CMDLINE) if cmdline is None else cmdline
    m = re.search(r"(?:^|\s)ostree=(\S+)", cmdline)
    if not m:
        return "", ""
    parts = m.group(1).strip("/").split("/")
    bootcsum = parts[3] if len(parts) >= 5 else ""
    target = os.path.basename(os.path.realpath(m.group(1)))
    return target.split(".")[0], bootcsum


def read_accepted() -> tuple:
    """(deployment commit, time text) of the last accept; ("", "") if none."""
    try:
        f = read(ACCEPTED).split()
    except OSError:
        return "", ""
    return (f[0], " ".join(f[1:])) if f else ("", "")


def usr_etc_changes(old: str, new: str) -> set | None:
    """/etc paths whose image default (/usr/etc) differs between two commits; None if
    ostree cannot tell (an old commit pruned)."""
    if not old or not new or old == new:
        return set()
    try:
        r = run(["ostree", "diff", "--repo=" + OSTREE_REPO, old, new], timeout=300)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    out = set()
    for line in r.stdout.splitlines():
        f = line.split(None, 1)
        if len(f) == 2 and f[1].startswith("/usr/etc/"):
            out.add("/etc/" + f[1][len("/usr/etc/"):])
    return out


# --- aide -------------------------------------------------------------------------------

def aide_entries(report: dict) -> list:
    """[(kind, path)] from aide's json report: kind + added, - removed, ~ changed.
    Grouped (default): objects path -> code; ungrouped: lists."""
    out = []
    for key, kind in (("added", "+"), ("removed", "-"), ("changed", "~")):
        v = report.get(key) or {}
        paths = v.keys() if isinstance(v, dict) else \
            [x if isinstance(x, str) else (x.get("path") or x.get("name") or "?") for x in v]
        out += [(kind, p) for p in paths]
    return sorted(out, key=lambda e: e[1])


def same_as_image(kind: str, path: str, attrs: set = frozenset()) -> bool:
    """An /etc entry as the booted image's default (/usr/etc): same type, mode, owner,
    content (link: target); removed: the image has none either. False when aide saw its
    label / ACL / xattrs change, or anything is unreadable."""
    if not path.startswith(ETC + "/") or attrs & LABEL_ATTRS:
        return False
    img = USR_ETC + path[len(ETC):]
    if kind == "-":
        return not os.path.lexists(path) and not os.path.lexists(img)
    try:
        a, b = os.lstat(path), os.lstat(img)
        if (stat.S_IFMT(a.st_mode), stat.S_IMODE(a.st_mode), a.st_uid, a.st_gid) != \
                (stat.S_IFMT(b.st_mode), stat.S_IMODE(b.st_mode), b.st_uid, b.st_gid):
            return False
        if stat.S_ISREG(a.st_mode):
            return filecmp.cmp(path, img, shallow=False)
        if stat.S_ISLNK(a.st_mode):
            return os.readlink(path) == os.readlink(img)
        return stat.S_ISDIR(a.st_mode)
    except OSError:
        return False


def priv_rules_explained() -> bool:
    """55-privileged.rules as audit-privileged-sync writes it for the booted image:
    root-owned, not group / other writable, content = its --print."""
    path = PRIV_RULES
    try:
        st = os.lstat(path)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != PRIV_OWNER or st.st_mode & 0o022:
            return False
        r = run([PRIV_SYNC, "--print"], timeout=300)
        return r.returncode == 0 and r.stdout != "" and r.stdout == read(path)
    except (OSError, subprocess.TimeoutExpired):
        return False


def update_explained(path: str, etc_changes: set | None) -> bool:
    if path.startswith(UPDATE_TREES) or path in AUDIT_TOOLS:
        return True
    if path in GENERATED or any(path.startswith(g) for g in GENERATED if g.endswith("/")):
        return True
    return etc_changes is not None and path in etc_changes


# --- GDM greeter drop-ins ----------------------------------------------------------------

def greeter_uid(path: str) -> int | None:
    """uid of a greeter drop-in path (folder or file) in the greeter range, else None."""
    m = GREETER_RE.fullmatch(path)
    if not m:
        return None
    uid = int(m.group(1) or m.group(2))
    return uid if uid in GREETER_UIDS else None


def journal_greeter_uids(lines: str = None) -> set:
    """uids of GDM greeter sessions in the journal (30 days, kept a month): PAM lines
    written by root only (_UID 0, set by journald: a user's logger line has its own)."""
    if lines is None:
        try:
            r = run(GREETER_JOURNAL)
        except (OSError, subprocess.TimeoutExpired):
            return set()
        if r.returncode not in (0, 1):
            return set()
        lines = r.stdout
    out = set()
    for line in lines.splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if not isinstance(e, dict) or e.get("_UID") != "0":
            continue
        m = GREETER_PAM.search(str(e.get("MESSAGE", "")))
        if m:
            out.add(int(m.group(1)))
    return out


def greeter_file_ok(path: str, prop: str) -> bool:
    """Regular, root-owned, not group / other writable, and only the one line
    <prop>=<number> (besides comments, empty lines and a [Slice] / [Service] header)."""
    try:
        st = os.lstat(path)
        if not os.path.isfile(path) or os.path.islink(path) or st.st_uid != GREETER_OWNER \
                or st.st_mode & 0o022 or st.st_size > 4096:
            return False
        text = read(path)
    except OSError:
        return False
    keys = []
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith(("#", ";")) or line in ("[Slice]", "[Service]"):
            continue
        keys.append(line)
    if len(keys) != 1 or "=" not in keys[0]:
        return False
    k, v = keys[0].split("=", 1)
    return k == prop and GREETER_VALUE_RE.fullmatch(v) is not None


def greeter_dir_ok(path: str) -> bool:
    """Root-owned folder, not group / other writable, holding only good property files."""
    try:
        st = os.lstat(path)
        if not os.path.isdir(path) or os.path.islink(path) or st.st_uid != GREETER_OWNER \
                or st.st_mode & 0o022:
            return False
        names = os.listdir(path)
    except OSError:
        return False
    for n in names:
        m = GREETER_FILE_RE.fullmatch(n)
        if not m or not greeter_file_ok(os.path.join(path, n), m.group(1)):
            return False
    return True


def greeter_explained(kind: str, path: str, proven: set) -> bool:
    """A greeter drop-in (added / changed: as logind writes it; removed: the name is
    enough) of a uid the journal shows as a GDM greeter session."""
    uid = greeter_uid(path)
    if uid is None or uid not in proven:
        return False
    if kind == "-":
        return True
    m = GREETER_RE.fullmatch(path)
    return greeter_file_ok(path, m.group(3)) if m.group(3) else greeter_dir_ok(path)


def group_entries(entries: list, booted: str, notes: list = None,
                  details: dict = None) -> list:
    """[(group, kind, path)]: group update (an OS update since the last accept), greeter
    (GDM login screen drop-ins), other. notes gets a line when ostree cannot tell.
    details: aide's json details (path -> changed attributes)."""
    acc, _ = read_accepted()
    new_deployment = bool(acc and booted and acc != booted)
    details = details if isinstance(details, dict) else {}
    etc = set()
    if new_deployment:
        etc = usr_etc_changes(acc, booted)
        if etc is None and notes is not None:
            notes.append(f"note: ostree diff {acc[:10]}..{booted[:10]} not possible "
                         "(old commit pruned): /etc changes compared with /usr/etc instead")
    proven = None
    out = []
    for kind, path in entries:
        attrs = details.get(path)
        attrs = set(attrs) if isinstance(attrs, dict) else set()
        if new_deployment and (update_explained(path, etc)
                               or (etc is None and same_as_image(kind, path, attrs))
                               or (path == PRIV_RULES and kind == "~" and priv_rules_explained())):
            out.append(("update", kind, path))
            continue
        if greeter_uid(path) is not None:
            if proven is None:
                proven = journal_greeter_uids() | live_greeter_uids()
            if greeter_explained(kind, path, proven):
                out.append(("greeter", kind, path))
                continue
        out.append(("other", kind, path))
    return out


def live_greeter_uids() -> set:
    """uids of gdm-greeter users known now (a login screen showing)."""
    import pwd
    try:
        return {p.pw_uid for p in pwd.getpwall()
                if p.pw_name.startswith("gdm-greeter") and p.pw_uid in GREETER_UIDS}
    except OSError:
        return set()


def check_aide(now: float, booted: str) -> Check:
    c = Check("aide")
    if not os.path.exists(AIDE_DB):
        return c.set("fail", "no database: sudo ./harden-workstation.sh integrity")
    try:
        age = now - os.stat(AIDE_JSON).st_mtime
        report = json.loads(read(AIDE_JSON))
    except FileNotFoundError:
        return c.set("unknown", "no aide report yet")
    except (OSError, ValueError) as e:
        return c.set("fail", f"aide report unreadable: {e}")
    if age > FRESH:
        return c.set("fail", f"aide did not report this run (report {int(age // 3600)} h old): "
                             "journalctl -u aidecheck.service")
    entries = aide_entries(report)
    _, acc_time = read_accepted()
    since = f" since {acc_time}" if acc_time else ""
    total = (report.get("number_of_entries") or {}).get("total", "?")
    if not entries:
        return c.set("pass", f"{total} entries, no change{since}")
    notes = []
    grouped = group_entries(entries, booted, notes, report.get("details"))
    for n in notes:
        c.item(n)
    count = {g: sum(1 for e in grouped if e[0] == g) for g in ("other", "greeter", "update")}
    shown = 0
    for group in ("other", "greeter", "update"):
        for g, kind, path in grouped:
            if g == group and shown < MAX_ITEMS:
                c.item(f"{group} {kind} {path}")
                shown += 1
    if shown < len(entries):
        c.item(f"... {len(entries) - shown} more: sudo harden-check --list shows all")
    return c.set("fail", f"{len(entries)} changed{since}: {count['other']} other, "
                         f"{count['greeter']} GDM greeter, {count['update']} from the OS update")


# --- boot files = image -----------------------------------------------------------------

def loader_entries(boot: str = BOOT) -> list:
    """[(entry file, linux, initrd, ostree=)] of the boot loader entries."""
    out = []
    for f in sorted(glob.glob(os.path.join(boot, "loader", "entries", "*.conf"))):
        kv = {}
        for line in read(f).splitlines():
            p = line.split(None, 1)
            if len(p) == 2:
                kv[p[0]] = p[1].strip()
        m = re.search(r"(?:^|\s)ostree=(\S+)", kv.get("options", ""))
        out.append((os.path.basename(f), kv.get("linux", ""), kv.get("initrd", ""),
                    m.group(1) if m else ""))
    return out


def check_boot_image(boot: str = BOOT) -> Check:
    """Each loader entry: its kernel and initramfs in /boot = vmlinuz / initramfs.img of
    its deployment (/usr/lib/modules/<kver>/). The booted one from /usr (composefs,
    verified); others from their deployment folder if it holds /usr."""
    c = Check("boot-image")
    try:
        entries = loader_entries(boot)
    except OSError as e:
        return c.set("unknown", f"{boot}/loader: {e.strerror}")
    if not entries:
        return c.set("unknown", "no boot loader entries")
    target = booted_target()
    booted_root = os.path.realpath(target) if target else ""
    same = differ = 0
    used = set()
    for name, linux, initrd, ostree in entries:
        kver = os.path.basename(linux).replace("vmlinuz-", "", 1)
        root = os.path.realpath(ostree) if ostree else ""
        usr = "/usr" if root and root == booted_root else os.path.join(root, "usr")
        mods = os.path.join(usr, "lib", "modules", kver)
        used.add(os.path.dirname(linux))
        for bootfile, imgname in ((linux, "vmlinuz"), (initrd, "initramfs.img")):
            have = os.path.join(boot, bootfile.lstrip("/"))
            want = os.path.join(mods, imgname)
            if not os.path.isfile(want):
                c.item(f"{name}: {imgname} not checked (no {want})")
                continue
            try:
                ok = filecmp.cmp(have, want, shallow=False)
            except OSError as e:
                c.item(f"{name}: {have}: {e.strerror}")
                differ += 1
                continue
            if ok:
                same += 1
            else:
                differ += 1
                c.item(f"{name}: {have} differs from {want}")
    for d in sorted(glob.glob(os.path.join(boot, "ostree", "*"))):
        if "/" + os.path.relpath(d, boot) not in used:
            c.item(f"no loader entry uses {d}")
    if differ:
        return c.set("fail", f"{differ} boot files differ from the image")
    if not same:
        return c.set("unknown", "nothing compared")
    extra = [i for i in c.items if i.startswith("no loader entry")]
    if extra:
        return c.set("fail", f"{len(extra)} folders in {boot}/ostree without an entry")
    return c.set("pass", f"{same} files = image ({len(entries)} entries)")


def booted_target() -> str:
    try:
        m = re.search(r"(?:^|\s)ostree=(\S+)", read(CMDLINE))
    except OSError:
        return ""
    return m.group(1) if m else ""


# --- root-only reads --------------------------------------------------------------------

def check_sudoers() -> Check:
    c = Check("sudoers")
    files = [SUDOERS] + sorted(glob.glob(os.path.join(SUDOERS_D, "*")))
    bad = 0
    for f in files:
        try:
            st = os.lstat(f)
        except OSError as e:
            c.item(f"{f}: {e.strerror}")
            bad += 1
            continue
        mode = st.st_mode & 0o7777
        if not os.path.isfile(f) or os.path.islink(f) or st.st_uid or st.st_gid or mode != 0o440:
            c.item(f"{f}: {oct(mode)[2:]} {st.st_uid}:{st.st_gid} (want 440 0:0, regular)")
            bad += 1
    try:
        r = run(["visudo", "-c", "-q"])
        if r.returncode:
            c.item(f"visudo -c: {(r.stdout + r.stderr).strip()[:200]}")
            bad += 1
    except (OSError, subprocess.TimeoutExpired) as e:
        c.item(f"visudo: {e}")
        bad += 1
    if bad:
        return c.set("fail", f"{bad} problems in {len(files)} files")
    return c.set("pass", f"{len(files)} files 440 root, syntax ok")


def conf_values(text: str) -> dict:
    out = {}
    for line in text.splitlines():
        m = re.match(r"\s*([A-Za-z_]+)\s*=\s*(.*?)\s*$", line)
        if m and not line.lstrip().startswith("#"):
            out[m.group(1)] = m.group(2)
    return out


def check_auditd_conf() -> Check:
    c = Check("auditd-conf")
    try:
        have = conf_values(read(AUDITD_CONF))
    except OSError as e:
        return c.set("unknown", f"{AUDITD_CONF}: {e.strerror}")
    for k, v in AUDITD_WANT.items():
        if have.get(k, "").upper() != v.upper():
            c.item(f"{k} = {have.get(k, '(unset)')}, want {v}")
    if c.items:
        return c.set("fail", f"{len(c.items)} of {len(AUDITD_WANT)} values differ")
    return c.set("pass", f"{len(AUDITD_WANT)} values as set")


def rule_lines(text: str) -> int:
    return sum(1 for ln in text.splitlines() if re.match(r"\s*-[aw]\s", ln))


def check_audit_loaded() -> Check:
    c = Check("audit-loaded")
    try:
        r = run(["auditctl", "-l"])
    except (OSError, subprocess.TimeoutExpired) as e:
        return c.set("unknown", f"auditctl: {e}")
    if r.returncode:
        return c.set("unknown", f"auditctl -l: {r.stderr.strip()[:120]}")
    loaded = rule_lines(r.stdout)
    want = 0
    try:
        for f in sorted(glob.glob(os.path.join(RULES_D, "*.rules"))):
            want += rule_lines(read(f))
    except OSError as e:
        return c.set("unknown", f"{RULES_D}: {e.strerror}")
    if loaded != want:
        return c.set("fail", f"{loaded} loaded, {want} in rules.d (a reboot loads rules.d)")
    return c.set("pass", f"{loaded} loaded = rules.d")


def check_accounts() -> Check:
    """No empty password, root locked, no system account (uid < 1000) with a usable
    password. Uids only, no names."""
    c = Check("accounts")
    try:
        uids = {}
        for line in read(PASSWD_DB).splitlines():
            f = line.split(":")
            if len(f) >= 3 and f[2].isdigit():
                uids[f[0]] = int(f[2])
        shadow = [ln.split(":") for ln in read(SHADOW).splitlines() if ln.count(":") >= 2]
    except OSError as e:
        return c.set("unknown", f"{e.filename}: {e.strerror}")
    usable = 0
    for f in shadow:
        uid, pw = uids.get(f[0], -1), f[1]
        if pw == "":
            c.item(f"uid {uid}: empty password")
        elif pw.startswith(("!", "*")):
            continue
        else:
            usable += 1
            if uid == 0:
                c.item("uid 0: root has a password (root stays locked)")
            elif uid < 1000:
                c.item(f"uid {uid}: system account with a password")
    if c.items:
        return c.set("fail", f"{len(c.items)} accounts not as wanted")
    return c.set("pass", f"{usable} login accounts, root and system accounts locked")


def check_firewalld_conf() -> Check:
    c = Check("firewalld-conf")
    try:
        have = conf_values(read(FIREWALLD_CONF)).get("DefaultZone", "(unset)")
    except OSError as e:
        return c.set("unknown", f"{FIREWALLD_CONF}: {e.strerror}")
    if have != DEFAULT_ZONE:
        return c.set("fail", f"DefaultZone={have}, want {DEFAULT_ZONE}")
    return c.set("pass", f"DefaultZone={have}")


def check_bpf_jit() -> Check:
    c = Check("bpf-jit")
    try:
        have = read(BPF_JIT).strip()
    except OSError as e:
        return c.set("unknown", f"{BPF_JIT}: {e.strerror}")
    st = "pass" if have == BPF_JIT_WANT else "fail"
    return c.set(st, f"net.core.bpf_jit_harden = {have}" + ("" if st == "pass" else f", want {BPF_JIT_WANT}"))


def check_applied() -> Check:
    c = Check("applied")
    try:
        names = [ln.strip() for ln in read(APPLIED).splitlines()
                 if ln.strip() and not ln.startswith("#")]
    except FileNotFoundError:
        return c.set("fail", f"no {APPLIED} (harden-workstation.sh writes it)")
    except OSError as e:
        return c.set("unknown", f"{APPLIED}: {e.strerror}")
    if not names:
        return c.set("fail", f"{APPLIED} empty")
    return c.set("pass", f"{len(names)} sections applied: {' '.join(names)}")


# --- result -----------------------------------------------------------------------------

def render(checks: list, now: float) -> str:
    stamp = datetime.datetime.fromtimestamp(now).astimezone().isoformat(timespec="seconds")
    out = ["# harden-check result (aidecheck.service); sectop posture row harden-check",
           f"time\t{int(now)}\t{stamp}"]
    for c in checks:
        out.append(f"check\t{c.id}\t{c.status}\t{clean(c.summary)}")
        out += [f"item\t{c.id}\t{i}" for i in c.items[:MAX_ITEMS + 1]]
    return "\n".join(out) + "\n"


def sectop_gid() -> int | None:
    import grp
    try:
        return grp.getgrnam(GROUP).gr_gid
    except KeyError:
        return None


def state_dir(path: str = STATE) -> None:
    """STATE 0750 root:sectop (the section makes it; here only if it is missing)."""
    if os.path.isdir(path):
        return
    os.makedirs(path, exist_ok=True)
    gid = sectop_gid()
    os.chown(path, 0, gid if gid is not None else 0)
    os.chmod(path, 0o750 if gid is not None else 0o700)


def write_result(text: str, path: str = RESULT) -> None:
    """Atomic, 0640 root:sectop (0600 root if there is no group sectop)."""
    d = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".result.")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        gid = sectop_gid()
        if gid is None:
            os.chmod(tmp, 0o600)
        else:
            os.chown(tmp, 0, gid)
            os.chmod(tmp, 0o640)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def all_checks(now: float) -> list:
    booted, _ = booted_deployment()
    checks = []
    for cid, fn in (("aide", lambda: check_aide(now, booted)), ("boot-image", check_boot_image),
                    ("sudoers", check_sudoers), ("auditd-conf", check_auditd_conf),
                    ("audit-loaded", check_audit_loaded), ("accounts", check_accounts),
                    ("firewalld-conf", check_firewalld_conf), ("bpf-jit", check_bpf_jit),
                    ("applied", check_applied)):
        try:
            checks.append(fn())
        except Exception as e:          # one broken check must not hide the others
            checks.append(Check(cid).set("unknown", f"error: {clean(e)}"))
    return checks


def do_check() -> int:
    now = time.time()
    checks = all_checks(now)
    write_result(render(checks, now))
    bad = [c.id for c in checks if c.status != "pass"]
    print(f"harden-check: {len(checks) - len(bad)} of {len(checks)} pass"
          + (f"; not pass: {' '.join(bad)}" if bad else ""))
    for c in checks:
        print(f"  {c.id:<15} {c.status:<7} {c.summary}")
    return 0


# --- init / accept ----------------------------------------------------------------------

def write_accepted() -> None:
    booted, _ = booted_deployment()
    stamp = datetime.datetime.now().astimezone().isoformat(timespec="minutes")
    fd, tmp = tempfile.mkstemp(dir=STATE, prefix=".accepted.")
    with os.fdopen(fd, "w") as f:
        f.write(f"{booted or '-'} {stamp}\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, ACCEPTED)


def unit_argv(cmd: str) -> list:
    """aide <cmd> in a transient service like aidecheck.service."""
    argv = ["systemd-run", "--wait", "--pipe", "--quiet", "--collect",
            "--unit=aidecheck-" + cmd.strip("-")]
    for p in UNIT_PROPS:
        argv += ["-p", p]
    return argv + [AIDE, cmd, "-c", AIDE_CONF]


def aide_as_unit(cmd: str) -> int:
    """aide --init; its report goes to this terminal. -> aide's exit status."""
    return subprocess.run(unit_argv(cmd)).returncode


def do_init() -> int:
    if os.path.exists(AIDE_DB):
        print(f"harden-check --init: {AIDE_DB} exists (sudo harden-check --accept)")
        return 1
    rc = aide_as_unit("--init")
    if rc != 0 or not os.path.exists(AIDE_NEW):
        print(f"harden-check --init: aide --init failed (exit {rc})")
        return 1
    os.replace(AIDE_NEW, AIDE_DB)
    write_accepted()
    print(f"harden-check --init: {AIDE_DB} built")
    return 0


def ask_line(prompt: str) -> str | None:
    """One line typed on the terminal (lower case, trimmed); None without a terminal
    or at its end (Ctrl+D)."""
    try:
        with open("/dev/tty") as tty:
            # keys typed earlier must not answer (admin scripts 40 / 42)
            import termios
            termios.tcflush(tty, termios.TCIFLUSH)
            # a whole line: an admin script's output filter (sed -u) passes lines only
            print(prompt, flush=True)
            line = tty.readline()
            return line.strip().lower() if line else None
    except OSError:
        return None


def aidecheck_state() -> tuple:
    """(ActiveState, start time) of aidecheck.service: a daily check running during
    --accept would write aide.json too."""
    try:
        r = run(["systemctl", "show", AIDECHECK, "-p", "ActiveState",
                 "-p", "ExecMainStartTimestampMonotonic"])
    except (OSError, subprocess.TimeoutExpired):
        return "", ""
    kv = dict(line.split("=", 1) for line in r.stdout.splitlines() if "=" in line)
    return kv.get("ActiveState", ""), kv.get("ExecMainStartTimestampMonotonic", "")


def aide_update_quiet() -> int:
    """aide --update like aide_as_unit, its long plain report not on the screen (the
    json report has it); a line every TICK seconds. -> aide's exit status."""
    t0 = time.monotonic()
    p = subprocess.Popen(unit_argv("--update"), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
    while True:
        try:
            return p.wait(timeout=TICK)
        except subprocess.TimeoutExpired:
            print(f"  ... {int(time.monotonic() - t0)} s", flush=True)


def sha256_file(path: str) -> str:
    import hashlib
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()


def hide_admin(text: str, name: str = None) -> str:
    """The admin account's name -> <admin> (a list may be uploaded: no admin name)."""
    name = os.environ.get("SUDO_USER", "") if name is None else name
    if not name or name == "root" or not re.fullmatch(r"[a-z_][a-z0-9_.-]*\$?", name):
        return text
    return re.sub(r"(?<![A-Za-z0-9_.-])" + re.escape(name) + r"(?![A-Za-z0-9_.-])", "<admin>", text)


def changed_attrs(report: dict, path: str) -> str:
    """Names of the attributes aide saw change (json details), no values."""
    d = report.get("details")
    d = d.get(path) if isinstance(d, dict) else None
    if not isinstance(d, dict):
        return ""
    names = sorted(k for k in d if isinstance(k, str) and ATTR.fullmatch(k))
    return "changed: " + " ".join(names) if names else ""


def build_list(grouped: list, report: dict, db_sha: str, head: list) -> tuple:
    """(list text, code, numbered other lines). Numbered over all groups, "other"
    first; the code = the first CODE_LEN characters of the sha256 of every line but
    the code line itself (head, counts, the new database's sha256, the items)."""
    import hashlib
    count = {g: sum(1 for e in grouped if e[0] == g) for g, _ in GROUPS}
    lines = list(head)
    lines += [f"database: {os.path.basename(AIDE_NEW)} sha256 {db_sha}",
              "local only: may hold wifi profile names, do not upload",
              "",
              f"changes: {len(grouped)}   " + " | ".join(f"{g} {count[g]}" for g, _ in GROUPS),
              "kind: + added   - removed   ~ changed"]
    width = len(str(max(len(grouped), 1)))
    other = []
    n = 0
    for group, what in GROUPS:
        lines += ["", f"== {group} ({count[group]}): {what}"]
        for g, kind, path in grouped:
            if g != group:
                continue
            n += 1
            attrs = changed_attrs(report, path) if kind == "~" else ""
            line = f"{n:>{width}}  {kind} {hide_admin(clean(path))}"
            line += f"   {attrs}" if attrs else ""
            lines.append(line)
            if group == "other":
                other.append(line)
        if not count[group]:
            lines.append("  (none)")
    body = "\n".join(lines) + "\n"
    code = hashlib.sha256(body.encode()).hexdigest()[:CODE_LEN]
    text = (lines[0] + "\n" + f"code: {code}   (type it on the text console to accept "
            "exactly this list)\n" + "\n".join(lines[1:]) + "\n")
    return text, code, other


def outbox_owner() -> int:
    v = os.environ.get("SUDO_UID", "")
    return int(v) if v.isdigit() else 0


def write_outbox(name: str, text: str, path: str = None, owner: int = None) -> str:
    """The list for the daily user: OUTBOX made by the admin (tools/admin-run.sh) or here
    for him; refused if anybody else owns it, it is a link, or group / others may write
    in it. The file: new, root-owned, 0644. -> its path; OSError / ValueError = why not."""
    path = OUTBOX if path is None else path
    owner = outbox_owner() if owner is None else owner
    try:
        os.mkdir(path, 0o700)
        made = True
    except FileExistsError:
        made = False
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        if made:
            os.fchown(fd, owner, -1)
            os.fchmod(fd, 0o755)
        st = os.fstat(fd)
        if st.st_uid not in (owner, 0) or st.st_mode & 0o022:
            raise ValueError(f"{path} is not the admin's (owner uid {st.st_uid}, "
                             f"mode {st.st_mode & 0o777:o})")
        f = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=fd)
        with os.fdopen(f, "w") as out:
            out.write(text)
            os.fchmod(out.fileno(), 0o644)
    finally:
        os.close(fd)
    return os.path.join(path, name)


def keep_record(name: str, text: str, path: str = None) -> None:
    """The accepted list in ACCEPTS (0700 root, files 0600), newest KEEP_ACCEPTS kept."""
    path = ACCEPTS if path is None else path
    os.makedirs(path, mode=0o700, exist_ok=True)
    flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW
    fd = os.open(os.path.join(path, name), flags, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text)
    old = sorted(n for n in os.listdir(path) if n.startswith("aide-accept-"))
    for n in old[:-KEEP_ACCEPTS]:
        os.unlink(os.path.join(path, n))


def page(text: str) -> None:
    """Page by page on the terminal (less in secure mode: no shell, no files, no
    history); printed as it is without a terminal."""
    if not sys.stdout.isatty():
        print(text, end="")
        return
    env = {"PATH": os.environ["PATH"], "LC_ALL": "C", "LESSSECURE": "1", "LESSHISTFILE": "-",
           "TERM": os.environ.get("TERM") or "linux"}
    try:
        subprocess.run(["less", "-K", "-Psspace next page   b back   q done"],
                       input=text, text=True, env=env)
    except OSError:
        print(text, end="")


def start_check() -> None:
    subprocess.run(["systemctl", "start", AIDECHECK])


def refuse(msg: str) -> int:
    if os.path.exists(AIDE_NEW):
        os.unlink(AIDE_NEW)
    print(msg)
    print("not accepted: the database is unchanged")
    return 1


def do_accept() -> int:
    if not os.path.exists(AIDE_DB):
        print("no database: sudo ./harden-workstation.sh integrity builds the first one")
        return 1
    state, started = aidecheck_state()
    if state in ("activating", "active", "deactivating", "reloading"):
        print(f"the daily check is running now ({AIDECHECK}): wait for it "
              f"(systemctl status {AIDECHECK}), then run again")
        return 1
    t0 = time.time()
    print("aide --update: reads every file in the scope (about a minute) ...", flush=True)
    rc = aide_update_quiet()
    took = int(time.time() - t0)
    if rc > 7 or not os.path.exists(AIDE_NEW):
        return refuse(f"aide --update failed (exit {rc}, {took} s)")
    if aidecheck_state()[1] != started:
        return refuse(f"the daily check ({AIDECHECK}) ran at the same time and wrote the "
                      "report too: run again")
    try:
        if os.stat(AIDE_JSON).st_mtime < t0 - 1:
            return refuse(f"{AIDE_JSON} is not from this run: run again")
        report = json.loads(read(AIDE_JSON))
    except (OSError, ValueError) as e:
        return refuse(f"{AIDE_JSON}: {e}")
    booted, _ = booted_deployment()
    acc, acc_time = read_accepted()
    notes = []
    grouped = group_entries(aide_entries(report), booted, notes, report.get("details"))
    db_sha = sha256_file(AIDE_NEW)
    stamp = datetime.datetime.now().astimezone()
    head = [f"harden-check --accept  {stamp.isoformat(timespec='seconds')}",
            f"last accept: {acc_time or 'none'}; deployment: "
            + ("new (an OS update since the last accept)" if acc and booted and acc != booted
               else "the same")] + notes
    text, code, other = build_list(grouped, report, db_sha, head)
    name = f"aide-accept-{stamp:%Y%m%d-%H%M%S}.txt"
    count = {g: sum(1 for e in grouped if e[0] == g) for g, _ in GROUPS}
    print(f"aide --update done ({took} s): {len(grouped)} changes since the last accept"
          + (f" ({acc_time})" if acc_time else ""))
    for g, what in GROUPS:
        print(f"  {g:<8} {count[g]:>5}  {what}")
    for n in notes:
        print(f"  {n}")
    try:
        listed = write_outbox(name, text)
    except (OSError, ValueError) as e:
        listed = ""
        print(f"list for the daily user NOT written: {clean(e)}")
    if listed:
        print(f"list for the daily user (GNOME): {listed}")
        print(f"  all {len(grouped)} numbered; the code to accept is at its top")
        if other:
            ask_line(f"Enter = the {len(other)} other items here, page by page "
                     "(space next page, b back, q done)")
            page(f"other (not explained): {len(other)} of {len(grouped)}, "
                 "numbers as in the list\n\n" + "\n".join(other) + "\n")
        else:
            print("  other: none (every change explained)")
    else:
        ask_line("Enter = the whole list here, page by page (space next page, b back, q done; "
                 "the code is at its top)")
        page(text)
    tries = 0
    while True:
        a = ask_line(f"accept? type the {CODE_LEN}-character code from the top of the list "
                     "(0 = no)")
        if a is None or a in ("0", "n", "no"):
            return refuse("answer: no")
        if a == code:
            break
        if a == "":
            continue                    # Enter alone: asked again, not counted
        tries += 1
        print(f"not the code of this list (try {tries} of {CODE_TRIES})")
        if tries >= CODE_TRIES:
            return refuse("no matching code")
    if not os.path.exists(AIDE_NEW) or sha256_file(AIDE_NEW) != db_sha:
        return refuse(f"{AIDE_NEW} changed while you read the list (another accept?): run again")
    if os.path.exists(AIDE_DB):
        os.replace(AIDE_DB, AIDE_DB + ".prev")
    os.replace(AIDE_NEW, AIDE_DB)
    write_accepted()
    try:
        keep_record(name, text)
    except OSError as e:
        print(f"record of the list not kept: {e.strerror}")
    print(f"accepted ({code}): {AIDE_DB} (previous: {AIDE_DB}.prev; list kept in {ACCEPTS}). "
          "Check again (about a minute) ...", flush=True)
    start_check()
    try:
        for line in read(RESULT).splitlines():
            if line.startswith("check\t"):
                _, cid, st, summ = (line.split("\t") + ["", "", ""])[:4]
                print(f"  {cid:<15} {st:<7} {summ}")
    except OSError as e:
        print(f"{RESULT}: {e.strerror}")
    return 0


def do_list() -> int:
    """Every change of the last aide report: group<TAB>kind<TAB>path (no limit)."""
    try:
        report = json.loads(read(AIDE_JSON))
    except (OSError, ValueError) as e:
        print(f"harden-check --list: {AIDE_JSON}: {e}", file=sys.stderr)
        return 1
    booted, _ = booted_deployment()
    notes = []
    grouped = group_entries(aide_entries(report), booted, notes, report.get("details"))
    for n in notes:
        print(f"# {n}")
    for g, kind, path in grouped:
        print(f"{g}\t{kind}\t{clean(path)}")
    return 0


def main(argv: list) -> int:
    if os.geteuid() != 0:
        print("harden-check: run as root (aidecheck.service, or sudo for --accept)", file=sys.stderr)
        return 2
    os.umask(0o077)
    state_dir()
    if argv == []:
        return do_check()
    if argv == ["--init"]:
        return do_init()
    if argv == ["--accept"]:
        return do_accept()
    if argv == ["--list"]:
        return do_list()
    print("usage: harden-check [--init | --accept | --list]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Exception as e:
        print(f"harden-check: {e}", file=sys.stderr)
        sys.exit(10)
