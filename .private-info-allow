# Reviewed hits of tools/check-private-info.sh that are fine in this repo.
# Format and rules: the header of that script.
#   <label> <path glob> <value regex>     full match, case-insensitive
# Keep it short: every line hides something from the check.

# systemd units with an instance (org.gnome.Shell@user.service ...) look like mail addresses.
email  *  [\w.:\\-]+@[\w.-]*\.(?:service|socket|scope|slice|target|timer|mount)

# NoScript add-on ID (public, the same in every Tor / Mullvad Browser): its toolbar button
uuid  browsevm/browsevm.ks  73a6fe31-595d-460b-a920-fcc0f8843232
# Mullvad Browser Extension add-on ID (public, the same in every Mullvad Browser): its permissions preset
uuid  browsevm/browsevm.ks  \{?d19a89b9-76c1-4a61-bcd4-49e8de916403\}?
uuid  docs/browsevm.md  \{?d19a89b9-76c1-4a61-bcd4-49e8de916403\}?

# host addresses of libvirt's default network and of the browse network (BROWSEVM_NET):
# defaults of libvirt / this repo, the same on every machine that uses them
ipv4  *  192\.168\.12[23]\.1

# section ids: 169.254.0.0/32 = "no such group" in Suricata's address groups (reserved, never a
# host); made-up hosts inside libvirt's default network / browsevm's network in the ids tests
ipv4  *  169\.254\.0\.0
ipv4  tests/*ids*  192\.168\.12[23]\.\d{1,3}
# made-up LAN of tests/test_lan_scan.py (tools/lan-scan.py)
ipv4  tests/test_lan_scan.py  10\.9\.\d{1,3}\.\d{1,3}
