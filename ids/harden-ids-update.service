# /etc/systemd/system/harden-ids-update.service - harden-workstation.sh section ids
# ET Open for Suricata (suricata-update, ids/update.yaml), as user suricata, through the
# tunnel: download, keep the categories of disable.conf, test with suricata -T (a failed
# test keeps the old rules), then a rule reload of a running suricata (SIGUSR2, as root).
[Unit]
Description=ET Open rules for Suricata (harden-ids)
Documentation=man:suricata(1)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/suricata/harden-ids/update.yaml

[Service]
Type=oneshot
User=suricata
Group=suricata
UMask=0027
ExecStart=/usr/bin/suricata-update -c /etc/suricata/harden-ids/update.yaml --suricata /usr/bin/suricata --no-reload
ExecStartPost=+/usr/bin/systemctl try-reload-or-restart suricata.service
TimeoutStartSec=20min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/suricata
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
